{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://am32.tridgell.net/ESCSim/schemas/manifest-v1.schema.json",
  "title": "ESCSim artifact manifest v1",
  "type": "object",
  "required": ["schema_version", "project", "release", "revision", "channel", "built_at", "targets"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"enum": ["firmware", "bootloader"]},
    "release": {"type": "string"},
    "revision": {"type": "string"},
    "channel": {"enum": ["stable", "development", "nightly"]},
    "built_at": {"type": "string"},
    "targets_header": {"$ref": "#/$defs/artifact"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["name", "family", "pin", "dronecan", "artifact"],
        "properties": {
          "name": {"type": "string"},
          "family": {"type": "string"},
          "pin": {"type": "string"},
          "dronecan": {"type": "boolean"},
          "artifact": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
